@model List<i2f.Models.SavedPdf>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My PDFs — ImageToPDF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .pdf-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }

        .pdf-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .pdf-card-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-main);
        }

        .pdf-card-meta {
            font-size: 12px;
            color: var(--text-muted);
        }

        .pdf-card-actions {
            display: flex;
            gap: 8px;
            margin-top: 4px;
            flex-wrap: wrap;
        }

        .btn-sm {
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 500;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            cursor: pointer;
            background: var(--surface);
            color: var(--text-main);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: background .12s;
        }

            .btn-sm:hover {
                background: var(--slate-100);
            }

            .btn-sm.danger {
                color: #dc2626;
                border-color: #fca5a5;
            }

                .btn-sm.danger:hover {
                    background: #fee2e2;
                }

            .btn-sm.primary {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
            }

                .btn-sm.primary:hover {
                    background: var(--accent-hover);
                }

        .search-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

            .search-bar input {
                flex: 1;
                padding: 10px 14px;
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                font-size: 14px;
                color: var(--text-main);
                outline: none;
                background: var(--surface);
            }

                .search-bar input:focus {
                    border-color: var(--accent);
                }

        .empty-state {
            text-align: center;
            padding: 60px 24px;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 48px;
                display: block;
                margin-bottom: 12px;
            }

        .rename-input {
            width: 100%;
            padding: 6px 10px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 14px;
            color: var(--text-main);
            outline: none;
            background: var(--surface);
            box-sizing: border-box;
        }

            .rename-input:focus {
                border-color: var(--accent);
            }
    </style>
</head>
<body>
    <nav class="navbar">
        <div style="display:flex;align-items:center;gap:16px;">
            <a href="/Pdf/Index" style="font-size:13px;color:var(--text-muted);text-decoration:none;">Convert</a>
            <a href="/Pdf/MyPdfs" style="font-size:13px;color:var(--accent);font-weight:600;text-decoration:none;">My PDFs</a>
            <form asp-action="Logout" asp-controller="Account" method="post" style="margin:0;">
                <button type="submit" style="background:none;border:none;cursor:pointer;font-size:13px;color:var(--text-muted);">Log out</button>
            </form>
        </div>
        <a class="logo" href="/Pdf/Index">
            <div class="logo-icon"><i class="ti ti-file-type-pdf"></i></div>
            ImageToPDF
        </a>
        <span class="nav-hint">free &amp; instant converter</span>
    </nav>

    <div class="page">
        <div class="card">
            <p class="section-label">My PDFs</p>
            <form method="get" asp-action="MyPdfs" asp-controller="Pdf" class="search-bar">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by title..." />
                <button type="submit" class="btn-sm primary">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a href="/Pdf/MyPdfs" class="btn-sm">Clear</a>
                }
            </form>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="ti ti-files"></i>
                    <p>No saved PDFs yet.</p>
                    <a href="/Pdf/Index" style="color:var(--accent);font-size:13px;">Convert your first one →</a>
                </div>
            }
            else
            {
                <div class="pdf-grid">
                    @foreach (var pdf in Model)
                    {
                        <div class="pdf-card">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <i class="ti ti-file-type-pdf" style="font-size:28px;color:var(--accent);"></i>
                                <div>
                                    <p class="pdf-card-title">@pdf.Title</p>
                                    <p class="pdf-card-meta">
                                        @pdf.PageCount page@(pdf.PageCount == 1 ? "" : "s") &middot;
                                        @pdf.Orientation &middot;
                                        @(pdf.FileSizeBytes / 1024) KB &middot;
                                        @pdf.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                    </p>
                                </div>
                            </div>
                            <form asp-action="Rename" asp-controller="Pdf" method="post"
                                  style="display:flex;gap:6px;">
                                <input type="hidden" name="id" value="@pdf.Id" />
                                <input class="rename-input" type="text" name="newTitle"
                                       value="@pdf.Title" placeholder="New title..." />
                                <button type="submit" class="btn-sm primary">Rename</button>
                            </form>
                            <div class="pdf-card-actions">
                                <a href="/Pdf/DownloadSaved?id=@pdf.Id" class="btn-sm primary">
                                    <i class="ti ti-download"></i> Download
                                </a>
                                <form asp-action="Delete" asp-controller="Pdf" method="post" style="margin:0;"
                                      onsubmit="return confirm('Delete @pdf.Title?')">
                                    <input type="hidden" name="id" value="@pdf.Id" />
                                    <button type="submit" class="btn-sm danger">
                                        <i class="ti ti-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</body>
</html>